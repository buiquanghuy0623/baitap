<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Giao diện Facebook Giản Lược</title>
    <!-- Liên kết đến tệp CSS -->
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <!-- Fixed Header ở trên cùng -->
    <header class="fixed-header">
        <div class="header-left">
            <h2>facebook</h2>
        </div>
        <div class="header-center">
            <input type="text" placeholder="Tìm kiếm trên Facebook...">
        </div>
        <div class="header-right">
            <span>Tài khoản</span>
        </div>
    </header>

    <!-- Khung chứa chính để bố trí Sidebar và Nội dung -->
    <div class="main-container">
        
        <!-- Sidebar bên trái -->
        <aside class="sidebar left-sidebar">
            <ul>
                <li><a href="#">Trang chủ</a></li>
                <li><a href="#">Trang cá nhân</a></li>
                <li><a href="#">Bạn bè</a></li>
                <li><a href="#">Nhóm</a></li>
                <li><a href="#">Kỷ niệm</a></li>
                <li><a href="#">Đã lưu</a></li>
            </ul>
        </aside>

        <!-- Phần nội dung chính ở giữa -->
        <main class="content">
            <div class="post-box">
                <h3>Tạo bài viết mới</h3>
                <textarea placeholder="Bạn đang nghĩ gì thế?"></textarea>
                <button>Đăng</button>
            </div>
            
            <div class="post-card">
                <h4>Nguyễn Văn A</h4>
                <p>Hôm nay là một ngày tuyệt vời để học lập trình web với CSS Grid và Flexbox!</p>
            </div>

            <div class="post-card">
                <h4>Trần Thị B</h4>
                <p>Chia sẻ một vài hình ảnh giao diện Facebook giản lược tự thiết kế.</p>
            </div>
        </main>

        <!-- Sidebar bên phải -->
        <aside class="sidebar right-sidebar">
            <h3>Người liên hệ</h3>
            <ul>
                <li>🟢 Trần Văn C</li>
                <li>🟢 Lê Thị D</li>
                <li>⚪ Phạm Văn E</li>
                <li>🟢 Hoàng Thị F</li>
            </ul>
        </aside>

    </div>

</body>
</html>
